<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YimengProto.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="YmBase">#0A0A0C</Color>
      <Color x:Key="YmAccent">#C8F542</Color>
      <SolidColorBrush x:Key="YmBaseBrush" Color="{StaticResource YmBase}"/>
      <SolidColorBrush x:Key="YmAccentBrush" Color="{StaticResource YmAccent}"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
