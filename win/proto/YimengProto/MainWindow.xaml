<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YimengProto.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="译梦">

  <Grid x:Name="RootGrid" Background="#FF0A0A0C">
    <Rectangle Fill="#FF0A0A0C" IsHitTestVisible="False"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="168"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FF101014" Padding="12,20,10,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,28">
            <canvas:CanvasControl Width="26" Height="26" Draw="BrandMark_Draw"/>
            <TextBlock Text="译梦" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SideNav" Grid.Row="1" Spacing="4"/>
          <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#66FFFFFF" FontSize="11" TextWrapping="WrapWholeWords" Margin="4,8,0,0"/>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <canvas:CanvasControl x:Name="FieldCanvas" Draw="FieldCanvas_Draw" IsHitTestVisible="False"/>

        <ScrollViewer x:Name="HomePane" Padding="32,28,32,100" VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="HomeStack" Spacing="8"/>
        </ScrollViewer>

        <ScrollViewer x:Name="LibraryPane" Visibility="Collapsed" Padding="32,28,32,100" VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="LibraryStack" Spacing="8"/>
        </ScrollViewer>

        <ScrollViewer x:Name="CollectionPane" Visibility="Collapsed" Padding="32,28,32,100" VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="CollectionStack" Spacing="8"/>
        </ScrollViewer>

        <ScrollViewer x:Name="SearchPane" Visibility="Collapsed" Padding="32,28,32,100" VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="SearchStack" Spacing="8"/>
        </ScrollViewer>

        <ScrollViewer x:Name="MePane" Visibility="Collapsed" Padding="32,28,32,100" VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="MeStack" Spacing="8"/>
        </ScrollViewer>

        <Grid x:Name="PlayerPane" Visibility="Collapsed" Padding="48,36,48,40">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Padding="8,6" CornerRadius="8" Background="#18FFFFFF" HorizontalAlignment="Left" PointerPressed="ClosePlayer_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <canvas:CanvasControl Width="16" Height="16" Draw="GlyphBack_Draw"/>
              <TextBlock Text="返回" Foreground="#CCFFFFFF" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" MaxWidth="520" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="CoverHost" MinHeight="280" MaxHeight="420">
              <canvas:CanvasControl x:Name="DoodleCanvas" Draw="DoodleCanvas_Draw"
                                   CreateResources="DoodleCanvas_CreateResources" IsHitTestVisible="False"/>
              <Border x:Name="PlayerCoverBorder" Width="240" Height="240" CornerRadius="18"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="#FFFF7A1A" BorderBrush="#33FFFFFF" BorderThickness="1">
                <canvas:CanvasControl x:Name="PlayerCoverFallback" Width="88" Height="88" Draw="BrandMark_Draw"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,16,0,0">
              <TextBlock x:Name="PlayerTitle" Text="—" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="PlayerArtist" Text="—" Foreground="#B3FFFFFF" FontSize="15" HorizontalAlignment="Center"/>
              <Slider x:Name="PlayerProgress" Minimum="0" Maximum="1" Value="0.35" StepFrequency="0.001"
                      Margin="0,14,0,0" Height="28"
                      Foreground="#FFC8F542" Background="#33FFFFFF"
                      ValueChanged="PlayerProgress_ValueChanged"/>
              <Grid>
                <TextBlock x:Name="PlayerPos" Text="1:24" Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PlayerDur" Text="4:02" Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="28" Margin="0,16,0,0">
                <canvas:CanvasControl Width="22" Height="22" Draw="GlyphHeart_Draw" PointerPressed="PlayerLike_Click"/>
                <canvas:CanvasControl Width="26" Height="26" Draw="GlyphPrev_Draw"/>
                <canvas:CanvasControl Width="40" Height="40" Draw="GlyphPauseBig_Draw"/>
                <canvas:CanvasControl Width="26" Height="26" Draw="GlyphNext_Draw"/>
                <canvas:CanvasControl Width="22" Height="22" Draw="GlyphQueue_Draw"/>
              </StackPanel>
              <Border Margin="0,20,0,0" Padding="16" CornerRadius="14" Background="#10FFFFFF">
                <StackPanel Spacing="6">
                  <TextBlock Text="歌词" Foreground="#73FFFFFF" FontSize="11"/>
                  <TextBlock Text="这一路走来不容易" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                  <TextBlock Text="你和我曾并肩前进" Foreground="#FFC8F542" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="梦还在心中不曾熄灭" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>

        <Border x:Name="MiniPlayerGlass" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Margin="24,0,24,20" Height="58" CornerRadius="29" Background="Transparent"
                PointerPressed="OpenPlayer_Click">
          <Grid Padding="10,0,18,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42"/><ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="MiniCoverBorder" Width="42" Height="42" CornerRadius="9" Background="#FFFF7A1A">
              <canvas:CanvasControl Width="22" Height="22" Draw="BrandMark_Draw"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock x:Name="MiniTitle" Text="—" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="MiniArtist" Text="—" Foreground="#B3FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <canvas:CanvasControl Width="22" Height="22" Draw="GlyphPause_Draw"/>
              <canvas:CanvasControl Width="20" Height="20" Draw="GlyphNext_Draw"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
